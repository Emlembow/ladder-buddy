+
+func requestUserAgentAllowed() bool {
+	return os.Getenv("ALLOW_REQUEST_USER_AGENT") == "true"
+}
+
+func customUserAgentAllowed() bool {
+	return requestUserAgentAllowed() && os.Getenv("ALLOW_CUSTOM_USER_AGENT") == "true"
+}
+
+func requestOverridesFromHeaders(c *fiber.Ctx) RequestOverrides {
+	return requestOverridesFromValues(c.Get(userAgentProfileHeader), c.Get(userAgentHeader))
+}
+
+func requestOverridesFromValues(profile string, userAgent string) RequestOverrides {
+	if !requestUserAgentAllowed() {
+		return RequestOverrides{}
+	}
+
+	overrides := RequestOverrides{
+		UserAgentProfile: strings.TrimSpace(profile),
+	}
+
+	if customUserAgentAllowed() {
+		overrides.UserAgent = strings.TrimSpace(userAgent)
+	}
+
+	return overrides
+}
+
+func resolveUserAgent(rule ruleset.Rule, overrides RequestOverrides) string {
+	if requestUserAgentAllowed() {
+		if overrides.UserAgentProfile != "" {
+			if userAgent, ok := userAgentProfiles[overrides.UserAgentProfile]; ok {
+				return userAgent
+			}
+		}
+
+		if customUserAgentAllowed() && overrides.UserAgent != "" {
+			return overrides.UserAgent
+		}
+	}
+
+	if rule.Headers.UserAgent != "" {
+		return rule.Headers.UserAgent
+	}
+
+	return UserAgent
+}
